{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ru.yriist/yriist",
  "title": "ЮрИИст",
  "description": "ИИ-юрист по праву РФ: судебная практика, нормы, контрагенты, расчёты, документы и сроки.",
  "version": "1.0.0",
  "websiteUrl": "https://yriist.ru",
  "repository": {
    "url": "https://github.com/Yriist/yriist-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://app.yriist.ru/api/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@yriist/mcp",
      "version": "1.0.0",
      "runtimeHint": "npx",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "YRIIST_TOKEN",
          "description": "Личный токен (yrp_…) вместо входа через браузер",
          "isSecret": true,
          "isRequired": false
        }
      ]
    }
  ]
}
